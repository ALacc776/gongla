      "css": ".ds-chat{font-family:-apple-system,'SF Pro Text',system-ui,sans-serif;background:#FFFFFF;padding:16px;display:flex;flex-direction:column;gap:10px;} .ds-bub-r{align-self:flex-start;max-width:85%;background:#E9E9EB;border-radius:20px;padding:9px 14px;display:flex;flex-direction:column;gap:8px;} .ds-segs{display:flex;flex-wrap:wrap;gap:4px 2px;} .ds-seg{display:flex;flex-direction:column;align-items:center;border-radius:6px;padding:0 1px;cursor:pointer;} .ds-seg:hover,.ds-seg-on{background:rgba(0,122,255,0.12);} .ds-seg b{font-weight:400;font-size:24px;line-height:32px;color:#000;} .ds-seg i{font-style:normal;font-size:12px;line-height:16px;color:rgba(60,60,67,0.6);} .ds-bub-f{display:flex;justify-content:space-between;align-items:flex-end;gap:10px;font-size:15px;line-height:20px;color:rgba(60,60,67,0.6);} .ds-spk{border:none;background:none;color:#007AFF;padding:0;cursor:pointer;} .ds-spk:active{opacity:.6;} .ds-spk:focus-visible{outline:2px solid rgba(0,122,255,.4);} .ds-bub-s{align-self:flex-end;max-width:85%;background:#007AFF;color:#FFFFFF;border-radius:20px;padding:9px 14px;font-size:22px;line-height:30px;}"
