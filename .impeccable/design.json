      "css": ".ds-comp{font-family:-apple-system,'SF Pro Text',system-ui,sans-serif;display:flex;align-items:flex-end;gap:6px;padding:8px;background:#FFFFFF;} .ds-field{flex:1;min-height:44px;box-sizing:border-box;border-radius:22px;border:1px solid rgba(60,60,67,0.29);padding:6px 8px 6px 16px;font-size:22px;line-height:30px;color:#000;background:#FFFFFF;} .ds-field::placeholder{color:rgba(60,60,67,0.3);} .ds-field:focus-visible{outline:none;border-color:#007AFF;} .ds-mic{width:44px;height:44px;border-radius:22px;border:none;background:#007AFF;color:#FFFFFF;display:flex;align-items:center;justify-content:center;cursor:pointer;} .ds-mic:active{opacity:.6;} .ds-mic:focus-visible{outline:3px solid rgba(0,122,255,.4);outline-offset:2px;} .ds-mic-rec{background:#FF3B30;box-shadow:0 0 0 8px rgba(255,59,48,0.35);transition:box-shadow .12s;}"
    }
